{
  "expo": {
    "name": "Eco Conecta",
    "slug": "ecoconecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/logo.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.giucaroline.ecoconecta"
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fc90da71-d224-4321-a836-bcba6a86e5de"
      }
    },
    "build": {
      "preview": {
        "distribution": "internal",
        "environment": "preview",
        "android": {
          "buildType": "apk"
        }
      }
    }
  }
}
