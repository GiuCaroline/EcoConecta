  "description": "EcoConecta",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently --kill-others -n APP,API,QUANTICO \"npm run dev:app\" \"npm run dev:api\" \"npm run dev:quantum\"",
    "dev:app": "npm --prefix ecoConecta run start",
    "dev:api": "npm --prefix backend run dev",
